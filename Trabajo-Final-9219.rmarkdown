```{r}

ruta_archivo <- "C:/Users/Mario Escobar/Downloads/Ciencias/Demografia/Demography_9219/Demography_9219/data/Tabla mort_guatemala.xlsx"

guatemala <- read_excel(ruta_archivo, 
                        sheet = "tabla mortalidad 1998",
                        skip = 2
                        )%>%
  
  rename_with(~case_when(
    .x %in% c("x", "x (edad)") ~ "x",
    .x %in% c("nKx", "K") ~ "K",
    .x %in% c("nDx", "D") ~ "D",
    TRUE ~ .x
  ))%>%

  mutate(
    x = as.numeric(x),
    n = as.numeric(n),
    K = as.numeric(K),
    D = as.numeric(D),
    
    mx = D/K #tasa mortalidad
  )

#funcion tablas de vida

lt_abr <- function(x, n, mx, sex = "f", IMR = NA){
  m <- length(x)
  ax <- n/2
  
  #ajuste coale-demeny para 0-1
  if(sex == "m"){
    ax[1] <- ifelse(mx[1] >= 0.107, 0.330, 0.45+2.684*mx[1])
  }else{
    ax[1] <- ifelse(mx[1]>=0.107,0.350, 0.053+2.800*mx[1])
  }
  
  #ajuste para 1-4
  
   if(sex == "m"){
    ax[2] <- ifelse(mx[1] >= 0.107, 1.352, 1.651+2.816*mx[1])
  }else{
    ax[2] <- ifelse(mx[1]>=0.107,1.361, 1.522+1.518*mx[1])
  } 
  
  #proba de morir
  
  qx <- (n*mx)/(1+(n-ax)*mx)
  qx[m] <- 1
  
  #proba supervivencia
  
  px <- 1-qx
  
  #lx
  
  lx <- 100000 * cumprod(c(1, px[-m]))
  
  #dx
  
  dx <- c(-diff(lx),lx[m])
  
  #Lx
  
  Lx <- n*c(lx[-1],0) + ax*dx
  Lx[m] <- lx[m]/mx[m]
  
  #Tx
  
  Tx <- rev(cumsum(rev(Lx)))
  
  #e_x
  
  ex <- Tx/lx
  
  return(data.table(x, n, mx, ax, qx, px, lx, dx, Lx, Tx, ex))
}

tabla_vida_1998 <- lt_abr(x = guatemala$x, n= guatemala$n, mx = guatemala$mx, sex = "f")
print(tabla_vida_1998)

```


```{r}

#grafica

ggplot(tabla_vida_1998, aes(x=x, y=mx)) + geom_line(color ="violet") +
scale_y_log10() + theme_minimal() + labs(title = "Tasa de mortalidad - Escala log",
                                         x ="Edad",
                                         y = "mx log")


```







