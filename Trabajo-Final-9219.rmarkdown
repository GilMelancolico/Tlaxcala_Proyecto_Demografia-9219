## Escritura de funciones

```{r}

weight_mean <- function(x, w = rep(1/length(x), length(x))) {
x_mean <- sum(x * w)/ sum(w)
return(x_mean)
}
# Ejemplo
weight_mean(c(10,40), c(.3,.7)) # Con peso

expo <- function(K_0, K_T, t_0, t_T, t){
  
  t0 <- decimal_date(as.Date(t_0))
  tT <- decimal_date(as.Date(t_T))
  
  r <- log(K_T / K_0) / (tT - t0)
  
  K_0 * exp(r * (t-t0))
}

cre_exp<-expo(K_0 = 112336538, K_T = 126014024, t_0= "2010-06-25", t_T="2020-03-15", t=seq(2020.5, 2100.5, 1))
                
#Grafica

data.frame(Año = c(decimal_date(as.Date("2010-06-25")), decimal_date(as.Date("2020-03-15")), seq(2020.5, 2100.5, 1)), K_t = c(112336538, 126014024, cre_exp)) %>%
  
ggplot(aes(Año,K_t)) + geom_line() + geom_point()

```


